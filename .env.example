# Forge Configuration
# Copy this file to .env and customize

# ── API ────────────────────────────────────────────────────────────────
FORGE_API_HOST=0.0.0.0
FORGE_API_PORT=8000
# REQUIRED for auth: generate with `openssl rand -hex 32`
FORGE_API_SECRET_KEY=
FORGE_API_URL=http://localhost:8000

# ── Auth ────────────────────────────────────────────────────────────────
# Token lifetime in minutes (default: 1440 = 24 hours)
FORGE_TOKEN_EXPIRE_MINUTES=1440
# Rate limit: requests per minute per IP
FORGE_RATE_LIMIT_PER_MINUTE=60

# ── Logging ─────────────────────────────────────────────────────────────
FORGE_LOG_LEVEL=INFO
FORGE_LOG_JSON=false

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://forge:forge_secret@localhost:5432/forge

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Qdrant (Vector DB) ──────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── MinIO (Object Storage) ──────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=forge
MINIO_SECRET_KEY=forge_secret
MINIO_SECURE=false
MINIO_DEFAULT_BUCKET=forge

# ── Ollama (LLM Inference) ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
FORGE_DEFAULT_MODEL=llama3.2:3b

# ── Paths ───────────────────────────────────────────────────────────────
FORGE_DATA_DIR=/var/lib/forge

# ── Observability ──────────────────────────────────────────────────────────
FORGE_METRICS_ENABLED=true
FORGE_TRACING_ENABLED=true
FORGE_OTLP_ENDPOINT=http://localhost:4318
FORGE_OTEL_CONSOLE_EXPORT=false
FORGE_SERVICE_NAME=forge
